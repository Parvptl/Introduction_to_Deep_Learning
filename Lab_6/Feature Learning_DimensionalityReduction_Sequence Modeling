    "# Pipeline:\n",
    "#   (10000, 128) → StandardScaler → PCA(50) → t-SNE(2) → plot\n",
    "#\n",
    "# WHY StandardScaler before PCA?\n",
    "#   PCA finds directions of maximum variance.\n",
    "#   If feature 1 ranges 0–1000 and feature 2 ranges 0–0.01,\n",
    "#   PCA will be dominated by feature 1 even if feature 2 is more informative.\n",
    "#   StandardScaler makes all features zero-mean, unit-variance.\n",
    "#   WHAT IF we skip it? PCA components become meaningless — dominated by scale.\n",
    "\n",
    "print(\"Step 1: Standardizing features...\")\n",
    "scaler = StandardScaler()\n",
    "features_scaled = scaler.fit_transform(cnn_features)   # (10000, 128)\n",
    "print(f\"  After scaling — mean: {features_scaled.mean():.4f}, std: {features_scaled.std():.4f}\")\n",
    "\n",
    "print(\"\\nStep 2: PCA (128 → 50 dimensions)...\")\n",
    "# n_components=50: keep 50 principal components.\n",
    "# Captures most variance, removes noise, speeds up t-SNE.\n",
    "pca = PCA(n_components=50, random_state=SEED)\n",
    "features_pca = pca.fit_transform(features_scaled)      # (10000, 50)\n",
    "\n",
    "explained_var = pca.explained_variance_ratio_.sum()\n",
    "print(f\"  Shape after PCA: {features_pca.shape}\")\n",
