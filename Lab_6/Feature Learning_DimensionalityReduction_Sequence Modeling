    "def extract_features_resnet(extractor, loader, device):\n",
    "    \"\"\"\n",
    "    Extract 512-dim ResNet-18 feature vectors and labels.\n",
    "    \"\"\"\n",
    "    extractor.eval()\n",
    "    all_features = []\n",
    "    all_labels   = []\n",
