   "source": [
    "# ============================================================\n",
    "# CELL 3 – Training the CNN\n",
    "# ============================================================\n",
    "#\n",
    "# WHY CrossEntropyLoss?\n",
    "#   = Softmax + Negative Log Likelihood combined.\n",
    "#   Penalises more when model is confidently WRONG.\n",
    "#   Works directly on raw logits (no softmax needed in model output).\n",
    "#   Do NOT apply softmax before this loss — double-softmaxing kills training.\n",
    "#\n",
    "# WHY Adam?\n",
    "#   Adaptive learning rate per parameter using gradient history.\n",
    "#   Converges faster than SGD. Default lr=0.001 usually works well.\n",
    "#   Alternative: SGD + momentum (more stable, better final accuracy,\n",
    "#   but needs careful LR scheduling).\n",
    "#\n",
    "# ⚠️ FIXED BUG from Parv's code:\n",
    "#   In the original, `correct` and `total` were NEVER reset between epochs.\n",
    "#   This means epoch 2 accuracy included epoch 1's counts → wrong cumulative accuracy.\n",
    "#   Fix: reset correct=0, total=0 at the start of each epoch.\n",
    "\n",
    "EPOCHS = 15\n",
    "LR     = 0.001\n",
    "\n",
    "criterion = nn.CrossEntropyLoss()\n",
    "optimizer = optim.Adam(cnn_model.parameters(), lr=LR, weight_decay=1e-4)\n",
    "\n",
    "# LR scheduler: reduce LR by 50% every 5 epochs\n",
    "scheduler = optim.lr_scheduler.StepLR(optimizer, step_size=5, gamma=0.5)\n",
    "\n",
    "train_losses = []\n",
    "train_accs   = []\n",
    "\n",
    "for epoch in range(1, EPOCHS + 1):\n",
    "    cnn_model.train()\n",
    "    \n",
    "    # ⚠️ CRITICAL: Reset per epoch (BUG FIX)\n",
    "    running_loss = 0.0\n",
    "    correct      = 0\n",
    "    total        = 0\n",
    "    \n",
    "    for images, labels in train_loader:\n",
    "        images, labels = images.to(device), labels.to(device)\n",
    "        \n",
    "        optimizer.zero_grad()               # Clear old gradients\n",
    "        logits = cnn_model(images)          # Forward pass\n",
    "        loss   = criterion(logits, labels)  # Compute loss\n",
    "        loss.backward()                     # Backpropagate\n",
    "        optimizer.step()                    # Update weights\n",
    "        \n",
    "        running_loss += loss.item()\n",
    "        preds         = logits.argmax(dim=1)\n",
    "        correct      += (preds == labels).sum().item()\n",
    "        total        += labels.size(0)\n",
    "    \n",
    "    scheduler.step()\n",
    "    \n",
    "    epoch_loss = running_loss / len(train_loader)\n",
    "    epoch_acc  = correct / total\n",
    "    \n",
    "    train_losses.append(epoch_loss)\n",
    "    train_accs.append(epoch_acc)\n",
    "    \n",
    "    print(f\"Epoch {epoch:02d}/{EPOCHS} | \"\n",
    "          f\"Loss: {epoch_loss:.4f} | \"\n",
    "          f\"Acc: {epoch_acc*100:.2f}% | \"\n",
    "          f\"LR: {scheduler.get_last_lr()[0]:.5f}\")"
   ]
