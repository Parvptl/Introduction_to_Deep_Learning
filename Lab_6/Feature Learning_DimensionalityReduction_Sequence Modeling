    "# WHY extract from FC(128) and not earlier?\n",
    "# - Convolutional layers output spatial maps (still 3D tensors)\n",
    "# - FC(128) is a compact semantic summary: 'this looks like a dog'\n",
    "# - Ideal for visualization\n",
    "#\n",
    "# IMPORTANT: We also collect the TRUE labels for correct coloring!\n",
    "# ⚠️ BUG FIX: Parv's code used `c = features_2d[:,0]` (x-coordinate of t-SNE)\n",
    "#    to color points. This is WRONG — it colors by position, not class.\n",
    "#    We must collect actual ground truth labels here.\n",
    "\n",
    "def extract_features_cnn(model, loader, device):\n",
    "    \"\"\"\n",
    "    Extract 128-dim feature vectors and ground truth labels from a DataLoader.\n",
    "    \n",
    "    Returns:\n",
    "        features: np.ndarray of shape (N, 128)\n",
    "        labels:   np.ndarray of shape (N,)  — TRUE class indices!\n",
    "    \"\"\"\n",
    "    model.eval()\n",
    "    all_features = []\n",
    "    all_labels   = []\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for images, labels in loader:\n",
    "            images = images.to(device)\n",
    "            \n",
    "            # Get 128-dim feature vectors\n",
    "            feats = model(images, return_features=True)  # (batch, 128)\n",
    "            \n",
    "            all_features.append(feats.cpu().numpy())\n",
    "            all_labels.append(labels.numpy())            # Collect TRUE labels!\n",
    "    \n",
    "    features = np.concatenate(all_features, axis=0)   # (N, 128)\n",
    "    labels   = np.concatenate(all_labels,   axis=0)   # (N,)\n",
    "    \n",
    "    return features, labels\n",
