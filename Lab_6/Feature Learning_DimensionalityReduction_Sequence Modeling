    "# ⚠️ CORRECT stop words loading (not set() on a path string!)\n",
    "STOP_WORDS = set(stopwords.words('english'))  # ~179 common English words\n",
    "print(f\"Stop words count: {len(STOP_WORDS)}\")\n",
    "print(f\"Sample stop words: {list(STOP_WORDS)[:15]}\")\n",
    "\n",
    "def preprocess_document(text):\n",
    "    \"\"\"\n",
    "    Clean and tokenize a document.\n",
    "    \n",
    "    Steps:\n",
    "    1. Lowercase\n",
    "    2. Remove non-alphabetic chars\n",
    "    3. Tokenize by whitespace\n",
    "    4. Remove stop words (the, is, a, ...)\n",
    "    5. Remove very short tokens (single chars like 'x', 'z')\n",
    "    \n",
    "    WHY remove stop words?\n",
    "    Words like 'the', 'is', 'a' appear in ALL documents equally.\n",
    "    They don't differentiate topics. Removing them makes the\n",
    "    model focus on content words ('baseball', 'satellite', 'firearm').\n",
    "    \"\"\"\n",
    "    text   = text.lower()\n",
    "    text   = re.sub(r'[^a-z\\s]', ' ', text)        # Keep only a-z and spaces\n",
    "    text   = re.sub(r'\\s+', ' ', text).strip()      # Normalize whitespace\n",
    "    tokens = text.split()\n",
    "    tokens = [t for t in tokens\n",
    "              if t not in STOP_WORDS and len(t) > 2]  # Remove stop words + short tokens\n",
    "    return tokens\n",
    "\n",
    "\n",
    "train_tokens = [preprocess_document(doc) for doc in train_docs]\n",
    "test_tokens  = [preprocess_document(doc) for doc in test_docs]\n",
    "\n",
