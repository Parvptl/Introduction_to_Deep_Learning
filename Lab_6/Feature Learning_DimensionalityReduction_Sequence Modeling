    "#   With 512 features, we should use PCA(50) first, then t-SNE.\n",
    "\n",
    "feature_extractor = nn.Sequential(*list(resnet.children())[:-1]).to(device)\n",
    "feature_extractor.eval()\n",
    "\n",
    "# Verify shape\n",
    "with torch.no_grad():\n",
    "    dummy = torch.zeros(2, 3, 32, 32).to(device)\n",
    "    out   = feature_extractor(dummy)      # (2, 512, 1, 1)\n",
    "    out   = out.squeeze(-1).squeeze(-1)   # (2, 512)\n",
    "    print(f\"ResNet feature vector shape: {out.shape}\")\n",
