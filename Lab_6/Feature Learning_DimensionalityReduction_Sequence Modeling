    "# ============================================================\n",
    "# CELL 2 – CNN Model Definition\n",
    "# ============================================================\n",
    "# Following EXACTLY the architecture specified in the question.\n",
    "# Key design notes are explained inline.\n",
    "\n",
    "class CNN(nn.Module):\n",
    "    \"\"\"\n",
    "    Architecture:\n",
    "        Conv(32, 3x3) → ReLU → MaxPool(2x2)\n",
    "        Conv(64, 3x3) → ReLU → MaxPool(2x2)\n",
    "        Flatten\n",
    "        Linear(128)   → ReLU      ← feature extraction point\n",
    "        Linear(10)                ← logits (no softmax: CrossEntropyLoss handles it)\n",
    "    \"\"\"\n",
    "    def __init__(self):\n",
    "        super(CNN, self).__init__()\n",
    "        \n",
    "        # ── Block 1 ──────────────────────────────────────────\n",
    "        # Input:  (batch, 3, 32, 32)\n",
    "        # After conv (padding=1): (batch, 32, 32, 32)\n",
    "        # After pool:             (batch, 32, 16, 16)\n",
    "        self.conv1 = nn.Conv2d(\n",
    "            in_channels=3,    # RGB: 3 input channels\n",
    "            out_channels=32,  # 32 feature maps\n",
    "            kernel_size=3,\n",
    "            padding=1         # preserve spatial dimensions\n",
    "        )\n",
    "        self.pool = nn.MaxPool2d(kernel_size=2, stride=2)\n",
    "        \n",
    "        # ── Block 2 ──────────────────────────────────────────\n",
    "        # Input:  (batch, 32, 16, 16)\n",
    "        # After conv: (batch, 64, 16, 16)\n",
    "        # After pool: (batch, 64, 8, 8)\n",
    "        self.conv2 = nn.Conv2d(\n",
    "            in_channels=32,\n",
    "            out_channels=64,\n",
    "            kernel_size=3,\n",
    "            padding=1\n",
    "        )\n",
    "        \n",
    "        # ── Batch Normalization ───────────────────────────────\n",
    "        # Normalizes activation maps to zero-mean, unit-variance.\n",
    "        # Stabilizes training significantly. Applied after conv, before ReLU.\n",
    "        self.bn1 = nn.BatchNorm2d(32)\n",
    "        self.bn2 = nn.BatchNorm2d(64)\n",
    "        \n",
    "        # ── Classifier Head ──────────────────────────────────\n",
    "        # After 2 max-pools: 32→16→8, so spatial size = 8×8\n",
    "        # Flattened: 64 × 8 × 8 = 4096\n",
    "        self.fc1     = nn.Linear(64 * 8 * 8, 128)  # Feature layer (128-dim)\n",
    "        self.dropout = nn.Dropout(0.5)              # Regularization\n",
    "        self.fc2     = nn.Linear(128, 10)           # Output layer\n",
    "        \n",
    "        self.relu = nn.ReLU()\n",
    "    \n",
    "    def forward(self, x, return_features=False):\n",
    "        \"\"\"\n",
    "        Args:\n",
    "            x: input tensor (batch, 3, 32, 32)\n",
    "            return_features: if True, return 128-dim feature vector (for extraction)\n",
    "        \"\"\"\n",
    "        # Block 1\n",
    "        x = self.relu(self.bn1(self.conv1(x)))  # Conv → BN → ReLU\n",
    "        x = self.pool(x)                         # MaxPool\n",
    "        \n",
    "        # Block 2\n",
    "        x = self.relu(self.bn2(self.conv2(x)))  # Conv → BN → ReLU\n",
    "        x = self.pool(x)                         # MaxPool\n",
    "        \n",
    "        # Flatten: (batch, 64, 8, 8) → (batch, 4096)\n",
    "        x = x.view(x.size(0), -1)\n",
    "        \n",
    "        # Fully connected feature layer\n",
    "        features = self.relu(self.fc1(x))        # (batch, 128) ← THIS IS OUR FEATURE VECTOR\n",
    "        \n",
    "        if return_features:\n",
    "            return features  # Return 128-dim embedding, skip classification head\n",
    "        \n",
    "        # Classification\n",
    "        x = self.dropout(features)\n",
    "        logits = self.fc2(x)                     # (batch, 10) — raw scores, NO softmax\n",
    "        return logits\n",
    "\n",
    "\n",
    "cnn_model = CNN().to(device)\n",
    "\n",
    "# ─── Parameter count ─────────────────────────────────────────\n",
    "total_params = sum(p.numel() for p in cnn_model.parameters())\n",
    "print(f\"CNN Architecture:\\n{cnn_model}\")\n",
    "print(f\"\\nTotal parameters: {total_params:,}\")\n",
    "\n",
    "# ─── Verify shapes with a dummy pass ─────────────────────────\n",
    "dummy = torch.zeros(2, 3, 32, 32).to(device)\n",
    "print(f\"\\nShape check:\")\n",
    "print(f\"  Input:          {dummy.shape}\")\n",
    "print(f\"  Features out:   {cnn_model(dummy, return_features=True).shape}\")\n",
    "print(f\"  Logits out:     {cnn_model(dummy).shape}\")"
