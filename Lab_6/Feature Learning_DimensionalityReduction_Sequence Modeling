    "\n",
    "# Build vocab from TRAINING data only (no test leakage)\n",
    "all_train_tokens = [t for doc in train_tokens for t in doc]\n",
    "word_freq = Counter(all_train_tokens)\n",
    "most_common = word_freq.most_common(VOCAB_SIZE - 2)  # -2 for special tokens\n",
    "\n",
    "vocab    = ['<PAD>', '<UNK>'] + [w for w, _ in most_common]\n",
    "word2idx = {w: i for i, w in enumerate(vocab)}\n",
    "actual_vocab_size = len(vocab)\n",
    "\n",
    "print(f\"Vocabulary size: {actual_vocab_size}\")\n",
    "\n",
    "\n",
    "def encode_and_pad(tokens, word2idx, max_len, pad_idx=0, unk_idx=1):\n",
    "    \"\"\"\n",
    "    Encode token list to padded integer array.\n",
    "    \n",
    "    Truncation strategy: keep LAST max_len tokens.\n",
    "    WHY? End of article often has conclusion/summary.\n",
    "    \n",
    "    Padding strategy: PRE-pad (pad at the front).\n",
    "    WHY? RNN/LSTM final hidden state sees the last tokens.\n",
    "    With pre-padding, final hidden state = end of REAL content, not PAD.\n",
    "    \"\"\"\n",
    "    encoded = [word2idx.get(t, unk_idx) for t in tokens[-max_len:]]\n",
    "    padded  = [pad_idx] * (max_len - len(encoded)) + encoded\n",
    "    return padded\n",
    "\n",
    "\n",
    "X_train = np.array([encode_and_pad(t, word2idx, MAX_LEN) for t in train_tokens])\n",
    "X_test  = np.array([encode_and_pad(t, word2idx, MAX_LEN) for t in test_tokens])\n",
