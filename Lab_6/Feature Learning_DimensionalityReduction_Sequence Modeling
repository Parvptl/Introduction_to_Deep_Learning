   "source": [
    "# ============================================================\n",
    "# CELL 10 – BiLSTM Model\n",
    "# ============================================================\n",
    "#\n",
    "# WHY BiLSTM for document classification?\n",
    "# - Documents have complex dependencies: a word's meaning depends on\n",
    "#   both preceding AND following context.\n",
    "# - Forward LSTM captures left context; Backward LSTM captures right context.\n",
    "# - Combined representation is richer than either alone.\n",
    "#\n",
    "# Architecture:\n",
    "#   Embedding(vocab, 128) → BiLSTM(128, 128, bidir) → concat [h_fwd | h_bwd]\n",
    "#   → Linear(256→256) → ReLU → [256-dim representation] → Linear(256→5)\n",
    "\n",
    "class TextBiLSTM(nn.Module):\n",
    "    \"\"\"\n",
    "    Bidirectional LSTM for document classification.\n",
    "    Produces a 256-dim document representation as required by Q2.\n",
    "    \"\"\"\n",
    "    def __init__(self, vocab_size, embed_dim, hidden_dim, num_classes,\n",
    "                 num_layers=1, dropout=0.4):\n",
    "        super().__init__()\n",
    "        \n",
    "        # Embedding: word_idx → dense vector\n",
    "        # padding_idx=0 → PAD token always maps to zero vector\n",
    "        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=PAD_IDX)\n",
    "        \n",
    "        # BiLSTM:\n",
    "        # hidden_size=hidden_dim (each direction)\n",
    "        # Output: 2 * hidden_dim (because bidirectional)\n",
    "        # With hidden_dim=128 → 256-dim concatenated output ✓\n",
    "        self.lstm = nn.LSTM(\n",
    "            input_size=embed_dim,\n",
    "            hidden_size=hidden_dim,    # 128 per direction\n",
    "            num_layers=num_layers,\n",
    "            batch_first=True,\n",
    "            bidirectional=True,        # Key flag!\n",
    "            dropout=dropout if num_layers > 1 else 0.0\n",
    "        )\n",
    "        \n",
    "        self.dropout1 = nn.Dropout(dropout)\n",
    "        \n",
    "        # Representation layer: maps hidden_dim*2 → 256\n",
    "        # (Already 256 if hidden_dim=128, but this makes it explicit and learnable)\n",
    "        self.fc_repr = nn.Linear(hidden_dim * 2, 256)\n",
    "        self.relu    = nn.ReLU()\n",
    "        \n",
    "        # Classification head\n",
    "        self.dropout2 = nn.Dropout(0.3)\n",
    "        self.fc_out   = nn.Linear(256, num_classes)\n",
    "    \n",
    "    def forward(self, x, return_features=False):\n",
    "        # x: (batch, seq_len)\n",
    "        emb = self.embedding(x)            # (batch, seq_len, embed_dim)\n",
    "        \n",
    "        # Run BiLSTM\n",
    "        # h_n shape: (num_layers * 2, batch, hidden_dim)\n",
    "        #   Factor 2 because bidirectional\n",
    "        _, (h_n, _) = self.lstm(emb)\n",
    "        \n",
    "        # Extract LAST forward and LAST backward hidden states\n",
    "        # For 1-layer BiLSTM: h_n[0]=forward, h_n[1]=backward\n",
    "        # For n-layer BiLSTM: h_n[-2]=last forward layer, h_n[-1]=last backward layer\n",
    "        h_fwd = h_n[-2]                    # (batch, hidden_dim) — last forward layer\n",
    "        h_bwd = h_n[-1]                    # (batch, hidden_dim) — last backward layer\n",
    "        \n",
    "        # Concatenate: (batch, hidden_dim*2) = (batch, 256)\n",
    "        hidden = torch.cat([h_fwd, h_bwd], dim=1)\n",
    "        hidden = self.dropout1(hidden)\n",
    "        \n",
    "        # 256-dim representation\n",
    "        features = self.relu(self.fc_repr(hidden))   # (batch, 256)\n",
    "        \n",
    "        if return_features:\n",
    "            return features   # Return 256-dim document embedding\n",
    "        \n",
    "        # Classify\n",
    "        out = self.dropout2(features)\n",
    "        return self.fc_out(out)            # (batch, num_classes)\n",
    "\n",
    "\n",
    "# Instantiate\n",
    "EMBED_DIM   = 128\n",
    "HIDDEN_DIM  = 128    # BiLSTM: 128 forward + 128 backward = 256 total ✓\n",
    "NUM_CLASSES = len(CATEGORIES)  # 5\n",
    "\n",
    "bilstm_model = TextBiLSTM(\n",
    "    vocab_size=actual_vocab_size,\n",
    "    embed_dim=EMBED_DIM,\n",
    "    hidden_dim=HIDDEN_DIM,\n",
    "    num_classes=NUM_CLASSES,\n",
    "    num_layers=1,\n",
    "    dropout=0.4\n",
    ").to(device)\n",
